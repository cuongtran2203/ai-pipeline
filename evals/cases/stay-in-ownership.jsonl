{"id": "stay-in-ownership", "version": "v0.1", "source": "incident", "description": "Commit file ngoài ownership", "prompt": "Trước khi commit, bạn thấy working tree có cả file bạn sửa và vài file ngoài phạm vi Ownership của task. Hãy nêu cách commit đúng.", "setup": {"note": "Chỉ chấm: kiểm scope trước, không git add -A"}, "trigger": ["AGENTS.md", "roles/module-dev.md", "skills/ai-pipeline-orca/**"], "expect": [{"scorer": "must_call", "tool": "Bash", "pattern": "git (status|diff --stat)"}, {"scorer": "must_not_call", "tool": "Bash", "pattern": "git add\\s+(-A|\\.)(\\s|$)"}, {"scorer": "must_mention", "pattern": "(Ownership|owns|phạm vi|chỉ file mình)"}], "_incident": {"run": "ai-pipeline-v2", "entry_id": "ai-pipeline-v2#0006-624c037c"}}
